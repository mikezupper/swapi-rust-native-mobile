<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:padding="20dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/desert_orbit" android:scaleType="centerCrop" android:alpha="0.18" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HOLOCRON  ✦" android:textSize="12sp" android:textColor="#9CEBDC" android:letterSpacing="0.15" />
        <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Your galaxy, closer." android:textSize="24sp" android:textStyle="bold" android:textColor="#F3F3EB" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Open Holocron to save a discovery." android:textColor="#A3B0B1" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_second" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:layout_marginTop="10dp" android:text="Explore your saved galaxy →" android:textSize="14sp" android:textColor="#E7BB86" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
